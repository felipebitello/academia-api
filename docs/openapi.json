{
    "openapi": "3.1.0",
    "info": {
        "title": "Academia API",
        "description": "Sistema de gest\u00e3o de academia: alunos, planos, matr\u00edculas e check-ins",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8080/backend",
            "description": "Generated server url"
        }
    ],
    "tags": [
        {
            "name": "Alunos",
            "description": "Cadastro de alunos, suas matr\u00edculas e check-ins"
        },
        {
            "name": "Matr\u00edculas",
            "description": "Matr\u00edcula de alunos em planos e controle de status"
        },
        {
            "name": "Planos",
            "description": "Planos oferecidos pela academia"
        }
    ],
    "paths": {
        "/planos/{id}": {
            "get": {
                "tags": [
                    "Planos"
                ],
                "summary": "Buscar plano por id",
                "operationId": "getOne",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Plano encontrado",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Plano"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Plano n\u00e3o encontrado",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Plano"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": [
                    "Planos"
                ],
                "summary": "Atualizar plano",
                "operationId": "put",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Plano"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Plano atualizado",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Plano"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Plano n\u00e3o encontrado",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Plano"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Planos"
                ],
                "summary": "Excluir plano",
                "operationId": "delete",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Plano exclu\u00eddo"
                    },
                    "409": {
                        "description": "Plano j\u00e1 usado em matr\u00edculas"
                    }
                }
            }
        },
        "/alunos/{id}": {
            "get": {
                "tags": [
                    "Alunos"
                ],
                "summary": "Buscar aluno por id",
                "operationId": "getOne_1",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Aluno encontrado",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Aluno"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Aluno n\u00e3o encontrado",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Aluno"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": [
                    "Alunos"
                ],
                "summary": "Atualizar aluno",
                "operationId": "put_1",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Aluno"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Aluno atualizado",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Aluno"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Dados inv\u00e1lidos",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Aluno"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Aluno n\u00e3o encontrado",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Aluno"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Alunos"
                ],
                "summary": "Excluir aluno",
                "operationId": "delete_1",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Aluno exclu\u00eddo"
                    },
                    "404": {
                        "description": "Aluno n\u00e3o encontrado"
                    },
                    "409": {
                        "description": "Aluno possui matr\u00edculas ou check-ins"
                    }
                }
            }
        },
        "/planos": {
            "get": {
                "tags": [
                    "Planos"
                ],
                "summary": "Listar planos",
                "operationId": "getAll",
                "responses": {
                    "200": {
                        "description": "Lista de planos",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Plano"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Planos"
                ],
                "summary": "Cadastrar plano",
                "operationId": "post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Plano"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Plano cadastrado",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Plano"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Dados inv\u00e1lidos",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Plano"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/matriculas": {
            "get": {
                "tags": [
                    "Matr\u00edculas"
                ],
                "summary": "Listar matr\u00edculas",
                "description": "Lista todas as matr\u00edculas, podendo filtrar por status",
                "operationId": "getAll_1",
                "parameters": [
                    {
                        "name": "status",
                        "in": "query",
                        "description": "ATIVA, TRANCADA ou CANCELADA",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "ATIVA",
                                "TRANCADA",
                                "CANCELADA"
                            ]
                        },
                        "example": "ATIVA"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de matr\u00edculas",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Matricula"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Matr\u00edculas"
                ],
                "summary": "Matricular aluno em um plano",
                "description": "Calcula o valor total conforme a forma de pagamento (PIX -10%, DINHEIRO -5%, CARTAO_CREDITO valor cheio)",
                "operationId": "post_1",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/MatriculaRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Matr\u00edcula criada",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Matricula"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Dados inv\u00e1lidos ou aluno j\u00e1 matriculado",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Matricula"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Aluno ou plano n\u00e3o encontrado",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Matricula"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/alunos": {
            "get": {
                "tags": [
                    "Alunos"
                ],
                "summary": "Listar alunos",
                "description": "Lista os alunos em ordem alfab\u00e9tica, podendo filtrar por parte do nome",
                "operationId": "getAll_2",
                "parameters": [
                    {
                        "name": "nome",
                        "in": "query",
                        "description": "Parte do nome do aluno",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "example": "felipe"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de alunos",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Aluno"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Alunos"
                ],
                "summary": "Cadastrar aluno",
                "operationId": "post_2",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Aluno"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Aluno cadastrado",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Aluno"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Dados inv\u00e1lidos ou CPF j\u00e1 cadastrado",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Aluno"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/alunos/{id}/check-ins": {
            "get": {
                "tags": [
                    "Alunos"
                ],
                "summary": "Listar check-ins do aluno",
                "description": "Do mais recente para o mais antigo",
                "operationId": "getCheckIns",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de check-ins",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/CheckIn"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Alunos"
                ],
                "summary": "Registrar entrada do aluno na academia",
                "description": "S\u00f3 permite se o aluno tiver matr\u00edcula ATIVA e dentro da validade",
                "operationId": "postCheckIn",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Check-in registrado",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/CheckIn"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Aluno sem matr\u00edcula ativa",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/CheckIn"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Aluno n\u00e3o encontrado",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/CheckIn"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/matriculas/{id}": {
            "get": {
                "tags": [
                    "Matr\u00edculas"
                ],
                "summary": "Buscar matr\u00edcula por id",
                "operationId": "getOne_2",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Matr\u00edcula encontrada",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Matricula"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Matr\u00edcula n\u00e3o encontrada",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Matricula"
                                }
                            }
                        }
                    }
                }
            },
            "patch": {
                "tags": [
                    "Matr\u00edculas"
                ],
                "summary": "Alterar status da matr\u00edcula",
                "description": "Trancar, reativar ou cancelar. Matr\u00edcula cancelada n\u00e3o pode mais ser alterada.",
                "operationId": "patch",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "action",
                        "in": "query",
                        "description": "trancar, reativar ou cancelar",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "example": "trancar"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Status alterado",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Matricula"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Transi\u00e7\u00e3o de status n\u00e3o permitida",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Matricula"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Matr\u00edcula n\u00e3o encontrada",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Matricula"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/alunos/{id}/matriculas": {
            "get": {
                "tags": [
                    "Alunos"
                ],
                "summary": "Hist\u00f3rico de matr\u00edculas do aluno",
                "operationId": "getMatriculas",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de matr\u00edculas do aluno",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Matricula"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Plano": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true
                    },
                    "nome": {
                        "type": "string",
                        "example": "Trimestral"
                    },
                    "descricao": {
                        "type": "string",
                        "example": "Muscula\u00e7\u00e3o livre, 3 meses"
                    },
                    "valorMensal": {
                        "type": "number",
                        "description": "Valor cobrado por m\u00eas",
                        "example": 99.9
                    },
                    "duracaoMeses": {
                        "type": "integer",
                        "format": "int32",
                        "description": "Dura\u00e7\u00e3o do plano em meses",
                        "example": 3
                    }
                }
            },
            "Aluno": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true
                    },
                    "nome": {
                        "type": "string",
                        "description": "Nome completo do aluno",
                        "example": "Felipe Bitello"
                    },
                    "cpf": {
                        "type": "string",
                        "description": "CPF somente n\u00fameros",
                        "example": 12345678900
                    },
                    "email": {
                        "type": "string",
                        "example": "felipe@email.com"
                    },
                    "telefone": {
                        "type": "string",
                        "example": 51999998888
                    },
                    "dataNascimento": {
                        "type": "string",
                        "format": "date",
                        "example": "2005-03-15"
                    },
                    "dataCadastro": {
                        "type": "string",
                        "format": "date",
                        "readOnly": true
                    }
                }
            },
            "MatriculaRequest": {
                "type": "object",
                "properties": {
                    "alunoId": {
                        "type": "string",
                        "format": "uuid",
                        "description": "Id do aluno",
                        "example": "d506994e-2e08-4f59-b33e-00f79ae84bb7"
                    },
                    "planoId": {
                        "type": "string",
                        "format": "uuid",
                        "description": "Id do plano",
                        "example": "a1b2c3d4-0000-0000-0000-000000000000"
                    },
                    "formaPagamento": {
                        "type": "string",
                        "description": "PIX (10% desconto), DINHEIRO (5% desconto) ou CARTAO_CREDITO",
                        "enum": [
                            "PIX",
                            "DINHEIRO",
                            "CARTAO_CREDITO"
                        ],
                        "example": "PIX"
                    }
                }
            },
            "Matricula": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "aluno": {
                        "$ref": "#/components/schemas/Aluno"
                    },
                    "plano": {
                        "$ref": "#/components/schemas/Plano"
                    },
                    "dataInicio": {
                        "type": "string",
                        "format": "date"
                    },
                    "dataFim": {
                        "type": "string",
                        "format": "date"
                    },
                    "valorTotal": {
                        "type": "number"
                    },
                    "formaPagamento": {
                        "type": "string",
                        "enum": [
                            "PIX",
                            "DINHEIRO",
                            "CARTAO_CREDITO"
                        ]
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "ATIVA",
                            "TRANCADA",
                            "CANCELADA"
                        ]
                    }
                }
            },
            "CheckIn": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "aluno": {
                        "$ref": "#/components/schemas/Aluno"
                    },
                    "dataHora": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            }
        }
    }
}
